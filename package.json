{
  "name": "lyricvideo",
  "version": "0.1.0",
  "description": "Farsi lyric video and karaoke builder with Claude-assisted lyrics, transliteration, translation and explanations",
  "main": "./out/main/index.js",
  "author": "arhopkins3",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
